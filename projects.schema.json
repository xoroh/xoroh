{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Xoroh project index",
  "description": "Machine-readable index of public Xoroh ecosystem projects. Covers public repositories only.",
  "type": "object",
  "required": ["projects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "canonical_repo",
          "default_branch",
          "status",
          "license",
          "runtimes",
          "platforms",
          "packages",
          "support_url",
          "release_policy",
          "security_reporting",
          "ecosystem_relations"
        ],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "canonical_repo": { "type": "string", "pattern": "^https://github\\.com/xoroh/" },
          "default_branch": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["scaffold", "active", "maintenance"] },
          "maturity": { "type": "string" },
          "maintainers": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "runtimes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "private", "published"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "private": { "type": "boolean" },
                "published": { "type": "boolean" }
              }
            }
          },
          "docs_url": { "type": "string" },
          "support_url": { "type": "string", "minLength": 1 },
          "release_policy": { "type": "string", "minLength": 1 },
          "security_reporting": { "type": "string", "minLength": 1 },
          "ecosystem_relations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
