{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "xoroh.org JSON search index",
	"type": "object",
	"required": ["entries"],
	"additionalProperties": false,
	"properties": {
		"entries": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["title", "url", "keywords"],
				"additionalProperties": false,
				"properties": {
					"title": { "type": "string", "minLength": 1 },
					"url": { "type": "string", "minLength": 1 },
					"keywords": {
						"type": "array",
						"minItems": 1,
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		}
	}
}
