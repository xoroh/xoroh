{
  "name": "xoroh",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check:index": "bun scripts/check-index.mjs",
    "check:fixture": "bun fixtures/min-consumer/scripts/check-adoption.mjs",
    "check:scaffold-trial": "bun scripts/check-scaffold-trial.mjs",
    "check:site": "bun scripts/check-site.mjs",
    "typecheck": "bun run --cwd apps/site typecheck",
    "build:site": "bun run --cwd apps/site build",
    "test": "bun test",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
